<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <submitter>IITTestPartnerUser</submitter>
        <type>portalRole</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <submitter>TestCOEAccountPartnerManager</submitter>
        <type>portalRole</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>CreatedDate</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Send_email_to_COE_admin_on_approval_of_project_proposal</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Status_update</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>winadmin@wadhwanifoundation.org</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Approval action by WIN</label>
        <name>Step_1</name>
        <rejectionActions>
            <action>
                <name>Send_email_to_CEO_admin_on_project_proposal_rejection</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Status_update_rejection</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>IndividualApplication.Status</field>
            <operation>equals</operation>
            <value>Proposal Approved by COE Admin</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Send_email_to_WIN_admin_on_approval_process</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Update_the_field_to_submitted</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Project Proposal Coe to Win Admin</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Send_email_for_project_proposal_recall_action</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_update_for_recall</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
