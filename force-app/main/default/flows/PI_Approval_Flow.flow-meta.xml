<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_email_COE_and_PI</name>
        <label>Assign email COE and PI</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>coeEmail</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_COE_Contact.Email</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>PI_Email</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_Proposal_Record.PI_User_Email__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_whether_Resubmission_Approval_of_Funding</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;path&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Check_the_status</name>
        <label>Check the status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Ask_for_Resubmission_by_COE_WIN</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Proposal_Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Asked for Resubmission by COE Admin</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Proposal_Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Asked for Resubmission by WIN Admin</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approval_Screen</targetReference>
            </connector>
            <label>Ask for Resubmission by COE/WIN ?</label>
        </rules>
        <rules>
            <name>No_Ask_for_Resubmission</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Proposal_Record.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Asked for Resubmission by COE Admin</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Proposal_Record.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Asked for Resubmission by WIN Admin</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>No_Approval_Screen</targetReference>
            </connector>
            <label>No Ask for Resubmission</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_whether_Resubmission_Approval_of_Funding</name>
        <label>Check whether Resubmission - Approval of Funding</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Thank_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Asked_for_Resubmission_by_COE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Proposal_Record.Application_Asked_for_Rsubmission__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_the_Proposal_Status_Resubmitted_back_to_COE</targetReference>
            </connector>
            <label>Yes- Asked for Resubmission by COE</label>
        </rules>
        <rules>
            <name>Yes_Resubmission_of_Approval_Funding_Checkbox_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Proposal_Record.Funding_Approval_Resubmission__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Thank_Screen</targetReference>
            </connector>
            <label>Yes - Resubmission of Approval Funding Checkbox True</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>ApprovalStepWin_Name</name>
        <dataType>String</dataType>
        <expression>&quot;ReSubmitted by &quot; &amp; {!Get_COE_Contact.Individual.FirstName} &amp; &quot; &quot; &amp; {!Get_COE_Contact.LastName}</expression>
    </formulas>
    <formulas>
        <name>ApproverRecordName</name>
        <dataType>String</dataType>
        <expression>&quot;Submitted by &quot; &amp; {!Get_Proposal_Record.CreatedBy.FirstName} &amp; &quot; &quot; &amp; {!Get_Proposal_Record.CreatedBy.LastName}</expression>
    </formulas>
    <interviewLabel>PI Approval Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun>
    <label>PI Approval Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Approval_History_Record_Resubmitted_to_COE</name>
        <label>Create Approval History Record Resubmitted to COE</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Thank_Screen</targetReference>
        </connector>
        <inputAssignments>
            <field>Assigned_To__c</field>
            <value>
                <elementReference>Get_Proposal_Record.COE_Approver__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Comments__c</field>
            <value>
                <elementReference>Comments</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>ApproverRecordName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Proposal__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Resubmitted Back</stringValue>
            </value>
        </inputAssignments>
        <object>Approval_History__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_COE_Contact</name>
        <label>Get COE Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_WIN_Admin_User</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Proposal_Record.COE_Approver__r.ContactId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Email</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Proposal_Record</name>
        <label>Get Proposal Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_the_status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>IndividualApplication</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_WIN_Admin_User</name>
        <label>Get WIN Admin User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_email_COE_and_PI</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>005F6000006BADjIAO</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_the_Proposal_Status_Resubmitted_back_to_COE</name>
        <label>Update the Proposal Status - Resubmitted back to COE</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Approval_History_Record_Resubmitted_to_COE</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Application_Resubmitted_to_COE__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PI_Comments__c</field>
            <value>
                <elementReference>Comments</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Proposal Resubmitted to COE Admin</stringValue>
            </value>
        </inputAssignments>
        <object>IndividualApplication</object>
    </recordUpdates>
    <screens>
        <name>Approval_Screen</name>
        <label>Approval Screen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Get_COE_Contact</targetReference>
        </connector>
        <fields>
            <name>Comments</name>
            <fieldText>Comments</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>No_Approval_Screen</name>
        <label>No Approval Screen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>displayNoApproval</name>
            <fieldText>&lt;blockquote&gt;&lt;p class=&quot;ql-quote-block&quot;&gt;This function is disabled and becomes available only when the COE or WIN Admin requests a proposal revision.&lt;/p&gt;&lt;/blockquote&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Close</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Thank_Screen</name>
        <label>Thank Screen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>thankPage</name>
            <fieldText>&lt;p&gt;Thanks Application successfully submitted to COE Admin.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Done</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Proposal_Record</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>COE_emailBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Dear {!Get_COE_Contact.Name},&lt;/p&gt;&lt;p&gt;Following the review of the application titled &lt;strong&gt;“{!Get_Proposal_Record.Project_Title__c}”&lt;/strong&gt;, the {!Get_COE_Contact.Account.Name} has requested &lt;strong&gt;resubmission&lt;/strong&gt; with revisions from the &lt;strong&gt;{!Get_COE_Contact.Account.BillingCity} &lt;/strong&gt;WIN-COE.&lt;/p&gt;&lt;p&gt;The review feedback outlining the required modifications is attached. Please ensure the revised application is prepared and submitted by &lt;strong&gt;[Deadline]&lt;/strong&gt;.&lt;/p&gt;&lt;p&gt;Should you require any assistance during the resubmission process, please don’t hesitate to reach out to &lt;strong&gt;[Name]&lt;/strong&gt; on &lt;strong&gt;[Email ID]&lt;/strong&gt; anytime.&lt;/p&gt;&lt;p&gt;Thank you for your cooperation and commitment to continuous improvement.&lt;/p&gt;&lt;p&gt;Sincerely,&lt;/p&gt;&lt;p&gt; &lt;strong&gt;Wadhwani Foundation&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>PI_Email_Body</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Dear [Dr./Prof.] {!Get_Proposal_Record.PI_Name__c},&lt;/p&gt;&lt;p&gt;Following the review of your application titled &lt;strong&gt;“{!Get_Proposal_Record.Project_Title__c}”&lt;/strong&gt;, the {!Get_COE_Contact.Account.Name} has requested &lt;strong&gt;resubmission&lt;/strong&gt; with revisions. The feedback outlining the areas that need to be addressed is attached.&lt;/p&gt;&lt;p&gt;Please review the comments carefully and prepare the revised submission latest by &lt;strong&gt;[Deadline]&lt;/strong&gt;. Please don’t hesitate to reach out to &lt;strong&gt;[Name]&lt;/strong&gt; on &lt;strong&gt;[Email ID]&lt;/strong&gt; to assist with any questions or clarifications during the resubmission process.&lt;/p&gt;&lt;p&gt;Thank you for your attention to this matter.&lt;/p&gt;&lt;p&gt;Sincerely,&lt;/p&gt;&lt;p&gt; &lt;strong&gt;Wadhwani Foundation&lt;/strong&gt;&lt;/p&gt;</text>
    </textTemplates>
    <variables>
        <name>coeEmail</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>PI_Email</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
