        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>con_rec.FirstName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_pi_contacts.First_Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>con_rec.LastName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_pi_contacts.Last_Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>con_rec.Email</assignToReference>
