        <assignmentItems>
            <assignToReference>con_rec.AccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Logged_in_user.AccountId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>con_rec.New_PI__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>con_rec.HomePhone</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_pi_contacts.Phone.value</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>opp_collection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>con_rec</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_pi_contacts</targetReference>
        </connector>
    </assignments>
    <customProperties>
