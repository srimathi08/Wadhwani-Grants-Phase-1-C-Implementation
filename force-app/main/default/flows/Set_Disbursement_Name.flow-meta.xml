<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>FDAutoName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Milestone__r.Name} &amp; &quot; - &quot; &amp;
TEXT(DAY(DATEVALUE($Record.DisbursementDate))) &amp; &quot;-&quot; &amp;
CASE(
  TEXT(MONTH(DATEVALUE($Record.DisbursementDate))),
  &quot;1&quot;,&quot;Jan&quot;,
  &quot;2&quot;,&quot;Feb&quot;,
  &quot;3&quot;,&quot;Mar&quot;,
  &quot;4&quot;,&quot;Apr&quot;,
  &quot;5&quot;,&quot;May&quot;,
  &quot;6&quot;,&quot;Jun&quot;,
  &quot;7&quot;,&quot;Jul&quot;,
  &quot;8&quot;,&quot;Aug&quot;,
  &quot;9&quot;,&quot;Sep&quot;,
  &quot;10&quot;,&quot;Oct&quot;,
  &quot;11&quot;,&quot;Nov&quot;,
  &quot;12&quot;,&quot;Dec&quot;,
  &quot;&quot;
) &amp; &quot;-&quot; &amp;
TEXT(YEAR(DATEVALUE($Record.DisbursementDate)))</expression>
    </formulas>
    <interviewLabel>Set Disbursement Name {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Set Disbursement Name</label>
    <processMetadataValues>
        <name>BuilderType</name>
