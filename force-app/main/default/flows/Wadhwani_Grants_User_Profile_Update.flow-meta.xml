    <decisions>
        <description>Run only for grant portal users. Compares the profile NAME so the flow works in every org (DEV: WCF Site User, WCF Reviewer; SIT/UAT/production: WG Partners, WG Internal).</description>
        <name>Is_Grants_Portal_Profile</name>
        <label>Is Grants Portal Profile</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Other profile</defaultConnectorLabel>
        <rules>
            <name>Grants_Portal_Profile</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>WCF Site User</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>WCF Reviewer</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>WG Partners</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>WG Internal</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assignment</targetReference>
            </connector>
            <label>Grants Portal Profile</label>
        </rules>
    </decisions>
