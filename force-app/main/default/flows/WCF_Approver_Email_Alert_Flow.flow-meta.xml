    <decisions>
        <name>Check_Approver_Found_Scheduled</name>
        <label>Check Approver Found (Scheduled)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Approver Found</defaultConnectorLabel>
        <rules>
            <name>Approver_Found_Scheduled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Approver_Account_Scheduled.PersonContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Decision_Overdue_Email_to_Approver</targetReference>
            </connector>
            <label>Approver Found (Scheduled)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_If_Decision_Recorded</name>
        <label>Check If Decision Recorded</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Decision Already Recorded</defaultConnectorLabel>
        <rules>
            <name>No_Decision_Recorded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Application_Decision.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Approver_Account_Scheduled</targetReference>
            </connector>
            <label>No Decision Recorded</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Recommendation</name>
        <label>Check Recommendation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Recommend_for_CEO_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Recommend_for_CEO_review__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Approver_Account.PersonContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Ready_for_Decision_Email_to_Approver</targetReference>
            </connector>
            <label>Recommend for CEO (Yes)</label>
        </rules>
        <rules>
            <name>Recommend_for_CEO_No</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Recommend_for_CEO_review__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Approver_Account.PersonContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Decline_Recommended_Email_to_Approver</targetReference>
            </connector>
            <label>Recommend for CEO (No)</label>
        </rules>
    </decisions>
    <description>WCF Approver Email Alert Flow for Ready for Decision (E-22), Decline Recommended (E-47), and Decision Overdue (E-55)</description>
