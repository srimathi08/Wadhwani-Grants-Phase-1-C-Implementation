    <decisions>
        <name>Check_if_Status_or_Comments_Updated</name>
        <label>Check if Status or Comments Updated</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Comments_updated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Comments__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Comments__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_to_COE_Team</targetReference>
            </connector>
            <label>Comments updated ?</label>
        </rules>
        <rules>
            <name>Status_Changed_TRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Question from Coe</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_to_WIN_Team</targetReference>
            </connector>
            <label>Status Changed = TRUE</label>
        </rules>
    </decisions>
