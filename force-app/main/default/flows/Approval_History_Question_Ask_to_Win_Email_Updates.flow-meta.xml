        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Hi {!$Record.Proposal__r.COE_Approver__c},&lt;/p&gt;&lt;p&gt;               WIN Team has reviewed your clarification request for the proposal titled &lt;strong&gt;{!$Record.Proposal__r.Project_Title__c}&lt;/strong&gt; submitted by {!$Record.Proposal__r.PI_Name__c}.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;WIN Response:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;{!$Record.Comments__c}&lt;/p&gt;&lt;p&gt;Please proceed with the next step of the review process.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 14px; font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;Sincerely,&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255); font-size: 14px; font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;Wadhwani Foundation&lt;/strong&gt;&lt;/p&gt;</text>
