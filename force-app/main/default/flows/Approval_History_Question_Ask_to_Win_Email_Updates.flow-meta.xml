    <textTemplates>
        <name>Coe_to_WIN_Body</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Hi WIN Team,&lt;/p&gt;&lt;p&gt;      The COE - {!$Record.Proposal__r.Account.Name} has a clarification request regarding the proposal submitted by &lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!$Record.Proposal__r.PI_Name__c}&lt;/span&gt;.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Proposal Title:&lt;/strong&gt; {!$Record.Proposal__r.Project_Title__c}&lt;/p&gt;&lt;p&gt;Please find the question below:&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Question from COE:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!$Record.Question_from_Coe__c}&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Kindly review and respond at the earliest so we can proceed with the assessment.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 14px; font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;Sincerely,&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255); font-size: 14px; font-family: Arial, sans-serif; color: rgb(0, 0, 0);&quot;&gt;Wadhwani Foundation&lt;/strong&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
