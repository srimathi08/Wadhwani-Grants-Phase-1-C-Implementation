<td tEditID="c1r2" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r2" locked="0" >
<![CDATA[<div style=""><font face="arial">&lt;p&gt;Dear {!IndividualApplication__c.Account__r.Name},&lt;/p&gt;</font></div><div style=""><font face="arial"><br></font></div><div style=""><font face="arial">&lt;p&gt;Thank you for submitting your application to Wadhwani Foundation – WCF Grant Management.&nbsp;</font></div><div style=""><font face="arial">We are writing to inform you of an important update regarding the review of your application.&lt;/p&gt;</font></div><div style=""><font face="arial"><br></font></div><div style=""><font face="arial">&lt;table border="0" cellpadding="6" cellspacing="0"&nbsp;</font></div><div style=""><font face="arial">&nbsp; &nbsp; &nbsp; &nbsp;style="border:1px solid #cccccc; width:100%; font-family:Arial, sans-serif; font-size:14px;"&gt;</font></div><div style=""><font face="arial">&nbsp; &lt;tr style="background-color:#f4f4f4;"&gt;</font></div><div style=""><font face="arial">&nbsp; &nbsp; &lt;td&gt;&lt;strong&gt;Application ID&lt;/strong&gt;&lt;/td&gt;</font></div><div style=""><font face="arial">&nbsp; &nbsp; &lt;td&gt;{!IndividualApplication__c.Name}&lt;/td&gt;</font></div><div style=""><font face="arial">&nbsp; &lt;/tr&gt;</font></div><div style=""><font face="arial">&nbsp; &lt;tr&gt;</font></div><div style=""><font face="arial">&nbsp; &nbsp; &lt;td&gt;&lt;strong&gt;Review Decision (Sec 1.2)&lt;/strong&gt;&lt;/td&gt;</font></div><div style=""><font face="arial">&nbsp; &nbsp; &lt;td&gt;{!IndividualApplication__c.Decision_Final_Decision_from_Sec_1_2__c}&lt;/td&gt;</font></div><div style=""><font face="arial">&nbsp; &lt;/tr&gt;</font></div><div style=""><font face="arial">&nbsp; &lt;tr style="background-color:#f4f4f4;"&gt;</font></div><div style=""><font face="arial">&nbsp; &nbsp; &lt;td&gt;&lt;strong&gt;Flagging Rationale&lt;/strong&gt;&lt;/td&gt;</font></div><div style=""><font face="arial">&nbsp; &nbsp; &lt;td&gt;{!IndividualApplication__c.Flag_rationale_Flagging_Criteria__c}&lt;/td&gt;</font></div><div style=""><font face="arial">&nbsp; &lt;/tr&gt;</font></div><div style=""><font face="arial">&lt;/table&gt;</font></div><div style=""><font face="arial"><br></font></div><div style=""><font face="arial">&lt;p&gt;Your application has been flagged for &lt;strong&gt;additional review&lt;/strong&gt; based on the&nbsp;</font></div><div style=""><font face="arial">criteria outlined above. Please note that this is &lt;strong&gt;not a final decision&lt;/strong&gt;.&nbsp;</font></div><div style=""><font face="arial">Our review team will conduct a further evaluation and will contact you if any additional&nbsp;</font></div><div style=""><font face="arial">information or documentation is required.&lt;/p&gt;</font></div><div style=""><font face="arial"><br></font></div><div style=""><font face="arial">&lt;p&gt;You will be notified of the final outcome as soon as the review process is complete.&lt;/p&gt;</font></div><div style=""><font face="arial"><br></font></div><div style=""><font face="arial">&lt;p&gt;If you have any questions or wish to provide additional context, please contact us at&nbsp;</font></div><div style=""><font face="arial">&lt;a href="mailto:[SupportEmail]"&gt;[SupportEmail]&lt;/a&gt;.&lt;/p&gt;</font></div><div style=""><font face="arial"><br></font></div><div style=""><font face="arial">&lt;p&gt;We appreciate your patience and cooperation.&lt;/p&gt;</font></div><div style=""><font face="arial"><br></font></div><div style=""><font face="arial">&lt;p&gt;Yours sincerely,&lt;br/&gt;</font></div><div style=""><font face="arial">&lt;strong&gt;{!Organization.Name}&lt;/strong&gt;&lt;br/&gt;</font></div><div style=""><font face="arial">WCF Grant Management Team&lt;/p&gt;</font></div>]]></td>
</tr>
