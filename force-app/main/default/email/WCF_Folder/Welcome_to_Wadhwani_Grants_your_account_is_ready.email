<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#eeeeee; padding:30px 0; font-family:Arial, Helvetica, sans-serif;">
  <tr>
    <td align="center">
      <table width="600" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff; border:1px solid #E6E6E6; border-radius:8px;">

        <!-- HEADER -->
        <tr>
          <td style="background-color:#BF2026; padding:24px 32px 22px; border-radius:8px 8px 0 0;">

            <!-- HEADER: TEXT LEFT, LOGO RIGHT (SAME ROW) -->
            <table width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td align="left" valign="middle">
                  <p style="margin:0 0 6px; color:#F9C9A8; font-size:12px; letter-spacing:1.5px; text-transform:uppercase; font-weight:bold;">
                    YOUR ACCOUNT
                  </p>

                  <h1 style="margin:0; color:#ffffff; font-size:26px; font-weight:bold; line-height:1.3;">
                    Welcome to Wadhwani Grants
                  </h1>
                </td>
                <td align="right" valign="middle" width="136" style="padding-left:16px;">
                  <img src="https://wadhwanifoundation--wfdev.sandbox.my.salesforce.com/servlet/servlet.ImageServer?id=015e10000020UmX&oid=00DF6000000APXN&lastMod=1782557340000"
                       width="136"
                       alt="Wadhwani Grants"
                       style="display:block;width:136px;height:auto;border:0;outline:none;text-decoration:none;">
                </td>
              </tr>
            </table>

          </td>
        </tr>

        <!-- ORANGE ACCENT BAR -->
        <tr>
          <td style="background-color:#F2672A; height:4px; line-height:4px; font-size:0;">&nbsp;</td>
        </tr>

        <!-- BODY -->
        <tr>
          <td style="padding:35px 40px 10px 40px; color:#333333; font-size:15px; line-height:1.6;">
            <p style="margin:0 0 18px 0;">
              Hello {!Receiving_User.FirstName},
            </p>

            <p style="margin:0 0 18px 0;">
              Thank you for your interest in working with Wadhwani Grants. Your account for
              <strong>{!Receiving_User.CompanyName}</strong> is now active.
            </p>

            <p style="margin:0 0 25px 0;">
              From here you can begin your Request for Information (RFI) — the first step in our grant process.
              You can save your progress and return as often as you need before submitting.
            </p>
          </td>
        </tr>

        <!-- BUTTON -->
        <tr>
          <td style="padding:0 40px 25px 40px;">
            <table cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="background-color:#BF2026; border-radius:4px;">
                  <a href="https://wadhwanifoundation--wfdev.sandbox.my.site.com/wcf/s/applicant-portal?language=en_US"
                     target="_blank"
                     style="display:inline-block; padding:13px 26px; color:#ffffff; text-decoration:none; font-weight:bold; font-size:15px; border-radius:4px;">
                    Start your application
                  </a>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- CLOSING -->
        <tr>
          <td style="padding:0 40px 30px 40px; color:#333333; font-size:15px; line-height:1.6;">
            <p style="margin:0 0 18px 0;">
              We look forward to learning more about the work
              <strong>{!Receiving_User.CompanyName}</strong> is doing to create and sustain jobs in your community.
            </p>

            <p style="margin:0;">
              Warm regards,<br/>
              The Wadhwani Grants Team
            </p>
          </td>
        </tr>

        <!-- DIVIDER -->
        <tr>
          <td style="padding:0 40px;">
            <hr style="border:none; border-top:1px solid #E6E6E6; margin:0;" />
          </td>
        </tr>

        <!-- FOOTER -->
        <tr>
          <td style="padding:22px 32px 26px; background:#ffffff; border-radius:0 0 8px 8px;">

            <!-- FOOTER LOGO -->
            <img src="https://wadhwanifoundation--wfdev.sandbox.my.salesforce.com/servlet/servlet.ImageServer?id=015e10000020VVh&oid=00DF6000000APXN&lastMod=1782560396000"
                 width="132"
                 alt="Wadhwani Grants"
                 style="display:block;width:132px;height:auto;margin:0 0 12px;"/>

            <p style="margin:0 0 4px; color:#6D6E71; font-size:11.5px; line-height:1.55;">
              Wadhwani Grants — the grant-making arm of the Wadhwani Foundation.
            </p>

            <p style="margin:0 0 4px; color:#6D6E71; font-size:11.5px; line-height:1.55;">
              Questions? Just reply to this email —
              <a href="mailto:grants.support@wadhwanifoundation.org"
                 style="color:#6D6E71; text-decoration:underline;">
                grants.support@wadhwanifoundation.org
              </a>
            </p>

            <p style="margin:0 0 4px; color:#6D6E71; font-size:11.5px; line-height:1.55;">
              © {!YEAR(TODAY())} Wadhwani Charitable Foundation. All rights reserved.
            </p>

            <p style="margin:0;">
              <a href="{!preferences_url}"
                 style="color:#6D6E71; font-size:11.5px; text-decoration:underline;">
                Notification preferences
              </a>
            </p>

          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>