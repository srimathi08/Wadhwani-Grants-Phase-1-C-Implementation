<![CDATA[<p style="color: rgb(24, 24, 24); box-sizing: border-box; margin-right: 0px; margin-left: 0px; padding: 0px; pointer-events: auto; counter-reset: list-1 0 list-2 0 list-3 0 list-4 0 list-5 0 list-6 0 list-7 0 list-8 0 list-9 0; white-space-collapse: preserve;"><font face="Arial, sans-serif" style="">Dear [Dr./Prof.] {!IndividualApplication.PI_Name__c},</font></p><p style="color: rgb(24, 24, 24); box-sizing: border-box; margin-right: 0px; margin-left: 0px; padding: 0px; pointer-events: auto; counter-reset: list-1 0 list-2 0 list-3 0 list-4 0 list-5 0 list-6 0 list-7 0 list-8 0 list-9 0; white-space-collapse: preserve;"><font face="Arial, sans-serif">

