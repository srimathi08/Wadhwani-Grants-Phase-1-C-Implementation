<td tEditID="c1r1" style=" background-color:#FFFFFF; bEditID:r3st1; color:#000000; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<p class="MsoNormal" style="margin-top:3.0000pt;margin-bottom:3.0000pt;"><span style="mso-spacerun:'yes';font-family:Arial;">Dear</span><span style="mso-spacerun:'yes';font-family:Arial;">&nbsp;Centre of Excellence,</span><span style="mso-spacerun:'yes';font-family:Arial;"><b>&nbsp;{!IndividualApplication.COE_Name__c}</b>,</span><span style="mso-spacerun:'yes';font-family:Arial;"><o:p></o:p></span></p><p class="MsoNormal" style="margin-top:3.0000pt;margin-bottom:3.0000pt;"><span style="mso-spacerun:'yes';font-family:Arial;">&nbsp;</span></p><p class="MsoNormal" style="margin-top:3.0000pt;margin-bottom:3.0000pt;"><span style="mso-spacerun:'yes';font-family:Arial;">We are pleased to inform you that the application titled <br>"<b>{!IndividualApplication.Project_Title__c}</b>" has been </span><span style="mso-spacerun:'yes';font-family:Arial;">selected for funding </span><span style="mso-spacerun:'yes';font-family:Arial;">by the Wadhwani Foundation as of {!IndividualApplication.ApprovedDate}.</span><span style="mso-spacerun:'yes';font-family:Arial;"><o:p></o:p></span></p><p class="MsoNormal" style="margin-top:3.0000pt;margin-bottom:3.0000pt;"><span style="mso-spacerun:'yes';font-family:Arial;">&nbsp;</span></p><p class="MsoNormal" style="margin-top:3.0000pt;margin-bottom:3.0000pt;"><span style="mso-spacerun:'yes';font-family:Arial;">Details</span><span style="mso-spacerun:'yes';font-family:Arial;">&nbsp;on the next steps and compliance requirements</span><span style="mso-spacerun:'yes';font-family:Arial;">&nbsp;will be shared shortly by our team</span><span style="mso-spacerun:'yes';font-family:Arial;"><o:p></o:p></span></p><p class="MsoNormal" style="margin-top:3.0000pt;margin-bottom:3.0000pt;"><span style="mso-spacerun:'yes';font-family:Arial;">&nbsp;</span></p><p class="MsoNormal" style="margin-top:3.0000pt;margin-bottom:3.0000pt;"><span style="mso-spacerun:'yes';font-family:Arial;">Congratulations to the entire COE team on this successful milestone.</span><span style="mso-spacerun:'yes';font-family:Arial;"><o:p></o:p></span></p><p class="MsoNormal" style="margin-top:3.0000pt;margin-bottom:3.0000pt;"><span style="mso-spacerun:'yes';font-family:Arial;">&nbsp;</span></p><p class="MsoNormal" style="margin-top:3.0000pt;margin-bottom:3.0000pt;"><span style="mso-spacerun:'yes';font-family:Arial;">&nbsp;</span></p><p class="MsoNormal" style="margin-top:3.0000pt;margin-bottom:3.0000pt;"><span style="mso-spacerun:'yes';font-family:Arial;">&nbsp;</span></p><p class="MsoNormal" style="margin-top:3.0000pt;margin-bottom:3.0000pt;"><span style="mso-spacerun:'yes';font-family:Arial;">Sincerely,</span><span style="mso-spacerun:'yes';font-family:Arial;"><o:p></o:p></span></p><p class="MsoNormal"><span style="mso-spacerun:'yes';font-family:Arial;"><b>Wadhwani Foundation</b></span><span style="mso-spacerun:'yes';font-family:Arial;"><br></span></p>]]></td>
</tr>
