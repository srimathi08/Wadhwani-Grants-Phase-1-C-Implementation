<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Due_Date__c</fullName>
    <formula>IF(
  ISBLANK(Last_Resubmission_Date__c),
  
  DATEVALUE(Initial_Submission_Date__c) +
  CASE(MOD(WEEKDAY(DATEVALUE(Initial_Submission_Date__c)) - 1, 7),
    0, 7, 1, 7, 2, 7, 3, 7, 4, 7, 5, 9, 6, 8, 7),
  
  DATEVALUE(Last_Resubmission_Date__c) +
  CASE(MOD(WEEKDAY(DATEVALUE(Last_Resubmission_Date__c)) - 1, 7),
    0, 7, 1, 7, 2, 7, 3, 7, 4, 7, 5, 9, 6, 8, 7)
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Due Date</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Date</type>
</CustomField>
