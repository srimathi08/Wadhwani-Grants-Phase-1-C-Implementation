<apex:page controller="WCFChangePasswordController" 
           showHeader="false" 
           sidebar="false" 
           standardStylesheets="false" 
           applyHtmlTag="true" 
           applyBodyTag="false" 
           docType="html-5.0" 
           title="Change your password">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change your password</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Barlow', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            min-height: 100vh;
        }

        /* Top Grey Tab Header Bar matching mockup */
        .portal-header-bar {
            background-color: #e5e7eb;
            height: 44px;
            padding: 0 40px;
            display: flex;
            align-items: flex-end;
            border-bottom: 1px solid #d1d5db;
        }

        .portal-tab {
            background-color: #ffffff;
            color: #1e293b;
            font-size: 14px;
            font-weight: 500;
            padding: 8px 24px;
            border-radius: 6px 6px 0 0;
            border: 1px solid #d1d5db;
            border-bottom: 1px solid #ffffff;
            margin-bottom: -1px;
        }

        /* Main Content Container */
        .main-container {
            padding: 36px 40px 60px 40px;
            background-color: #ffffff;
            min-height: calc(100vh - 44px);
        }

        .form-card {
            max-width: 480px;
            width: 100%;
        }

        /* Wadhwani Foundation Header Logo matching mockup */
        .brand-header {
            margin-bottom: 24px;
        }

        .brand-title {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: 0.5px;
            color: #a6192e;
            line-height: 1.1;
        }

        .brand-subtitle {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.8px;
            color: #475569;
            margin-top: 2px;
        }

        /* Title */
        .page-title {
            font-size: 28px;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 20px;
            line-height: 1.25;
        }

        /* Form Controls */
        .form-group {
            margin-bottom: 18px;
        }

        .form-label {
            display: block;
            font-size: 14px;
            font-weight: 500;
            color: #334155;
            margin-bottom: 6px;
        }

        .form-input {
            width: 100%;
            max-width: 340px;
            height: 38px;
            padding: 6px 12px;
            font-family: inherit;
            font-size: 14px;
            color: #0f172a;
            background-color: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            outline: none;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .form-input:focus {
            border-color: #a6192e;
            box-shadow: 0 0 0 3px rgba(166, 25, 46, 0.12);
        }

        /* Error Notification Banner */
        .alert-error {
            background-color: #fef2f2;
            border-left: 4px solid #a6192e;
            color: #991b1b;
            padding: 10px 14px;
            font-size: 13px;
            border-radius: 4px;
            margin-bottom: 18px;
            max-width: 340px;
        }

        /* Save Button */
        .save-btn {
            background-color: #a6192e;
            color: #ffffff !important;
            font-family: inherit;
            font-size: 14px;
            font-weight: 600;
            padding: 8px 26px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
            transition: background-color 0.2s ease;
            margin-top: 4px;
        }

        .save-btn:hover {
            background-color: #881224;
        }
    </style>
</head>
<body>
    <!-- Top Grey Tab Bar matching mockup -->
    <div class="portal-header-bar">
        <div class="portal-tab">Change your password</div>
    </div>

    <!-- Main Content Area -->
    <div class="main-container">
        <div class="form-card">
            <!-- Wadhwani Foundation Header Logo matching mockup -->
            <div class="brand-header">
                <div class="brand-title">WADHWANI</div>
                <div class="brand-subtitle">FOUNDATION</div>
            </div>

            <!-- Page Title -->
            <h1 class="page-title">Change your password</h1>

            <!-- Error Notification -->
            <apex:outputPanel id="errorPanel" layout="block">
                <apex:outputPanel rendered="{!NOT(ISBLANK(errorMessage))}" layout="block" styleClass="alert-error">
                    <apex:outputText value="{!errorMessage}" />
                </apex:outputPanel>
            </apex:outputPanel>

            <!-- Change Password Form -->
            <apex:form id="changePasswordForm">
                <div class="form-group">
                    <label class="form-label" for="oldPassword">Current password</label>
                    <apex:inputSecret id="oldPassword" 
                                      value="{!oldPassword}" 
                                      styleClass="form-input" 
                                      required="true" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="newPassword">New password</label>
                    <apex:inputSecret id="newPassword" 
                                      value="{!newPassword}" 
                                      styleClass="form-input" 
                                      required="true" />
                </div>

                <div class="form-group">
                    <apex:commandButton value="Save" 
                                        action="{!doChangePassword}" 
                                        styleClass="save-btn" 
                                        reRender="errorPanel" />
                </div>
            </apex:form>
        </div>
    </div>
</body>
</apex:page>