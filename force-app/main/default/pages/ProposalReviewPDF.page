<apex:page standardController="ApplicationReview"
           extensions="ProposalReviewPDFController"
           renderAs="pdf"
           showHeader="false"
           sidebar="false"
           applyBodyTag="false">
<style>
    @page {
        margin: 55px 55px 55px 55px;
        size: A4;
    }
    body {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 11px;
        color: #2c2c2c;
    }
</style>

